projection implementation in class zbp_hcm_c_ecd unique;
strict ( 2 );
use draft;
use side effects;
define behavior for zhcm_c_ecd alias ECD
use etag
{
  use create(augment);
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Prepare;
  use action resume;
use association _Attachment { create; with draft;}
use association _Approval { create; with draft;}
}

define behavior for zhcm_c_ecd_attach alias Attachment
use etag
{
  use update;
  use delete;
  use association _Ecd {with draft;}
}

define behavior for zhcm_c_ecd_approvals alias Approval
use etag
{
 // use update;
  //use delete;
  use association _Ecd {with draft;}
}
