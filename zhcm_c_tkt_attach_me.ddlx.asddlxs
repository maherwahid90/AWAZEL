    Filename;
       @UI: { lineItem:       [ { position: 20, importance: #HIGH } ],
                             identification: [ { position: 20 } ]
         }
         @EndUserText.label: 'Comments'
         @UI.multiLineText: true
    Comments;
    @UI.hidden: true
