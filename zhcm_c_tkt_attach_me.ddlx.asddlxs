    with
{
@UI.facet: [ { id:            'Attachment',
                 purpose:       #STANDARD,
                 type:          #IDENTIFICATION_REFERENCE,
                 label:         'Attachment',
                 position:      10 } ]
    @UI.hidden: true
    AttachmentUuid;
    @UI.hidden: true
    RequestUuid;
    @UI.hidden: true
