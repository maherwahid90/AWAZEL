projection implementation in class zbp_hcm_c_tkt unique;
strict ( 2 );
use draft;
use side effects;
define behavior for zhcm_c_tkt alias TKT
use etag
{
  use create(augment);
  use update;
  use delete;

  use action Activate;
  use action Discard;
  use action Edit;
  use action Prepare;
  use action resume;
use association _Family { create; with draft;}
use association _Approval { create; with draft;}
}

define behavior for zhcm_c_tkt_family alias Family
use etag
{
  use create;
  use update;
  use delete;
  use association _Ticket {with draft;}
}

define behavior for zhcm_c_tkt_approvals alias Approval
use etag
{
 // use update;
  //use delete;
  use association _Ticket {with draft;}
}
