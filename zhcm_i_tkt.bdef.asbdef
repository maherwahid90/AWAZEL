managed implementation in class zbp_hcm_i_tkt unique;
strict ( 2 );
with draft;
define behavior for zhcm_i_tkt alias TKT
persistent table Zhcm_ticket_req
with additional save
draft table zhcm_dr_tkt
lock master
total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update(features : instance);
  delete(features : instance);
  association _Attachment { create;with draft; }
  association _Member { create;with draft; }
  association _Approval { create;with draft; }
  determination setRequestNumber on save { create; }
  determination populateMembers on modify { create; field TicketType; }
  side effects
  {
    field TicketType affects entity _Member;
  }
  validation validateTicket on save { create; field TicketType,Begda, Endda; }
  field ( mandatory) Pernr,TicketType,Begda,Endda;
  field ( numbering : managed, readonly ) RequestUuid;
  field ( readonly ) LocalLastChangedAt,LocalCreatedAt;
   field ( features : instance ) Pernr,hiredate,PlansTxt,OrgehTxt,RequestId;
  draft determine action Prepare{}
 draft action resume;
 draft action Edit;
 draft action Activate optimized;
 draft action Discard;

  mapping for zhcm_ticket_req{
 RequestUuid = request_uuid;
    RequestId = request_id;
    Pernr = pernr ;
    TicketType = ticket_type;
    Begda = begda;
    Endda = endda;
    TicketDirection = ticket_direction;
    TravelDestination = travel_destination;
    JourneyRoute = journey_route;
    Remarks=remarks ;
    ReqStatus= req_status;
    LocalCreatedBy=local_created_by;

    LocalCreatedAt=local_created_at ;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt=last_changed_at ;
  }

}

define behavior for zhcm_i_tkt_attach alias _Attachment
persistent table Zhcm_tick_attach
draft table zhcm_dr_tkt_at
lock dependent by _Ticket
authorization dependent by _Ticket
etag master LocalLastChangedAt
{
  update;
  delete;
  field ( mandatory ) Attachment;
  field ( readonly ) RequestUuid;
  field ( readonly ) LocalLastChangedAt,LocalCreatedAt;
  association _Ticket {with draft;}
  field (numbering : managed,readonly) AttachmentUuid;
  mapping for zhcm_tick_attach{

AttachmentUuid = attachment_uuid ;
   RequestUuid =  request_uuid ;
    Attachment = attachment ;
    Mimetype = mimetype;
    Filename = filename;
    Comments = comments;
        LocalCreatedBy=local_created_by;

    LocalCreatedAt=local_created_at ;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt=last_changed_at ;

  }
}

define behavior for zhcm_i_tkt_member alias _Member
  early numbering
persistent table Zhcm_tick_member
draft table zhcm_dr_tkt_mem
lock dependent by _Ticket
authorization dependent by _Ticket
{
  create;
  update;
  delete;
  determination calculateAge on modify { create; field Birthdate; }
  field ( mandatory ) Name;
  field ( readonly ) RequestUuid,FamilySeq,Age;
  association _Ticket {with draft;}
  mapping for zhcm_tick_member{

   RequestUuid =  request_uuid ;
    FamilySeq = family_seq ;
    Selected = selected;
    Name = name;
    Birthdate = gbdat;
    Age = age;
    PassportNo = passport_no;

  }
}


define behavior for zhcm_i_tkt_approvals alias _Approval
persistent table zhcm_tick_approv
draft table zhcm_dr_tkt_aps
lock dependent by _Ticket
authorization dependent by _Ticket
etag master ReceiveTs
{
  update(features : instance);
  delete(features : instance);
  field ( readonly ) RequestUuid,ApprovalSeq;
  association _Ticket {with draft;}
  mapping for zhcm_tick_approv{

   RequestUuid =  request_uuid ;
    ApprovalSeq = approval_seq ;
    ApprovalPernr = approval_pernr;
    ApprovalName = approval_name;
    ReceiveTs = receive_ts;
    CompleteTs = complete_ts;
    Status = status;
   ApprovalComment = approval_comment;

  }
}
